# Postgres (Vercel Postgres / Neon). En Vercel, al conectar la base desde el
# dashboard (Storage -> Create Database -> Postgres) estas variables se
# agregan solas al proyecto.
DATABASE_URL="postgres://user:password@host/dbname?sslmode=require"

# NextAuth
# Genera uno con: openssl rand -base64 32
AUTH_SECRET="reemplaza-esto-con-un-valor-aleatorio-largo"
# URL pública del sitio desplegado (en local: http://localhost:3000)
NEXTAUTH_URL="http://localhost:3000"

# Vercel Blob (Storage -> Create Database -> Blob en el dashboard de Vercel)
BLOB_READ_WRITE_TOKEN="vercel_blob_rw_xxxxxxxx"
